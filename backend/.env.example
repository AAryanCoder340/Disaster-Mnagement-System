# Server
PORT=3000

# SQLite database file path (relative to backend/ or absolute)
DATABASE_PATH=./data/coastwatch.db

# Default anonymous reporter user (created on first run if missing)
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USERNAME=CurrentUser
DEFAULT_DISPLAY_NAME=Current User

# Incident clustering
CLUSTER_RADIUS_KM=25
CLUSTER_WINDOW_HOURS=24

# Official ingest interval
OFFICIAL_INGEST_MINUTES=15

# IMD API (https://api.imd.gov.in/) — registration + JWT/API key required
# Unauthenticated requests currently return HTTP 401
IMD_API_TOKEN=
IMD_API_KEY=
IMD_JWT=

# NDMA SACHET public RSS XML URL (not the CapFeed HTML page)
# CAP XML documents: https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile?identifier=...
SACHET_RSS_URL=
